# Copier dans .env et remplacer les valeurs avant démarrage. Ne pas commiter .env.
POSTGRES_DB=naido_db
POSTGRES_USER=naido_user
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=naido_db
DB_USER=naido_user
DB_PASS=REPLACE_WITH_SAME_DATABASE_PASSWORD
DATABASE_URL=postgresql://naido_user:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/naido_db
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:8095
